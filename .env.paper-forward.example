# ==============================================================================
# Tradewithhamed - Stage 8 30-Day Paper-Forward Environment Template
# ==============================================================================
# STRICT SAFETY BOUNDARY:
# This file is for READ-ONLY paper forward simulation.
# Broker order creation is architecturally impossible (brokerWrites: false).
# All outgoing orders (NEW_ORDER_REQ, 2106) are blocked fail-closed before socket transmission.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. cTrader Open API Credentials & Endpoint (DEMO ONLY)
# ------------------------------------------------------------------------------
# Strictly enforced: only 'demo' environment is permitted.
CTRADER_ENVIRONMENT=demo

# Host: must be verified demo endpoint
CTRADER_GATEWAY_HOST=demo.ctraderapi.com

# Port: Official cTrader Open API JSON WebSocket port is 5036.
# NOTE: Port 5035 is deprecated protobuf and is rejected in preflight.
CTRADER_GATEWAY_PORT=5036

# Your cTrader Open API credentials from https://open-api.ctrader.com/
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=

# Transport runtime flags
RUN_CTRADER=1
REQUIRE_CTRADER=1
CTRADER_LIVE_ENABLE=false

# Socket timeout & heartbeat settings
CTRADER_HEARTBEAT_MS=10000
CTRADER_STALE_MS=4000
CTRADER_MAX_RECONNECT=10

# ------------------------------------------------------------------------------
# 2. Stage 8 Paper Forward Monitor Configuration
# ------------------------------------------------------------------------------
# Primary symbol to monitor: GBPUSD, EURUSD, USDJPY, XAUUSD
MONITOR_SYMBOL=GBPUSD

# Timeframe for bar accumulation and rule evaluation: 5M or 1M
MONITOR_TIMEFRAME=5M

# Directory where append-only JSONL event reports are stored
STAGE8_REPORT_DIR=data/runs/stage8-30d

# ------------------------------------------------------------------------------
# 3. Advisory Provider Selection
# ------------------------------------------------------------------------------
# Options:
#   DETERMINISTIC : (Recommended default) Offline, zero API keys, rule-based critic
#   WEBLLM        : Browser-only WebGPU (blocked in headless Node runtime)
#   OPENAI        : Remote OpenAI JSON critic (requires OPENAI_API_KEY)
#   GEMINI        : Remote Google Gemini critic (requires GEMINI_API_KEY)
#   XAI           : Remote xAI Grok critic (requires XAI_API_KEY)
MONITOR_ANALYST_PROVIDER=DETERMINISTIC

# Optional remote AI credentials (leave blank if using DETERMINISTIC):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

XAI_API_KEY=
XAI_MODEL=grok-beta
