# ==============================================================================
# Hamed Trading Lab - Environment Variables Template
# All secret values MUST remain server-side only. NEVER commit actual secrets here.
# ==============================================================================

# Application URL (Auto-injected in AI Studio / Cloud Run, or http://localhost:3000 locally)
APP_URL="http://localhost:3000"

# AI Studio / Gemini API Key (Server-side only)
GEMINI_API_KEY=""

# cTrader Open API Credentials (For B2 Stage - Server-Side Only)
# Register at: https://help.ctrader.com/open-api/api-application/
CTRADER_CLIENT_ID=""
CTRADER_CLIENT_SECRET=""
CTRADER_REDIRECT_URI=""
CTRADER_ENVIRONMENT="demo"

# Server-Side Token Vault Encryption Key (Optional AES-256 seed; fallback auto-derived in demo)
CTRADER_TOKEN_ENCRYPTION_KEY=""
